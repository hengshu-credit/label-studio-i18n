index 0000000..bfd3e23
--- /dev/null
+++ b/web/libs/app-common/src/i18n/ui.ts
@@ -0,0 +1,24 @@
+import chinese from "./locales/ui-zh-CN.json";
+
+let selected: string | undefined;
+export function setUILanguage(language: string) { selected = language; }
+export function currentLanguage(): string {
+  if (selected) return selected;
+  try {
+    const saved = typeof localStorage === "undefined" ? null : localStorage.getItem("label-studio.language");
+    if (saved === "en" || saved === "zh-CN") return saved;
+  } catch { /* Storage may be unavailable in embedded/private browsers. */ }
+  const languages = typeof navigator === "undefined" ? [] : (navigator.languages || [navigator.language]);
+  for (const language of languages) {
+    if (/^zh(?:$|-cn|-sg|-hans)/i.test(language)) return "zh-CN";
+    if (/^en(?:$|-)/i.test(language)) return "en";
+  }
+  return "en";
+}
+/** Framework-free source-literal translation, safe during core/UI module initialization. */
+export function uiT(source: string, values: Record<string, unknown> = {}): string {
+  const catalog = chinese as Record<string, string>;
+  const text = currentLanguage() === "zh-CN" ? (catalog[source] ?? source) : source;
+  return text.replace(/\{\{(\w+)\}\}/g, (placeholder, key) =>
+    Object.prototype.hasOwnProperty.call(values, key) ? String(values[key]) : placeholder);
+}

@@ -0,0 +1,31 @@
+import time
+from pathlib import Path
+from django.conf import settings
+from django.core.management.base import BaseCommand, CommandError
+from django.db import close_old_connections
+from ml.active_learning import process_backends
+
+
+class Command(BaseCommand):
+    help = 'Run durable active learning rounds (one worker per shared data directory).'
+
+    def add_arguments(self, parser):
+        parser.add_argument('--once', action='store_true')
+        parser.add_argument('--interval', type=int, default=15)
+
+    def handle(self, *args, **options):
+        import fcntl  # Worker runs in the Linux Label Studio container.
+        with (Path(settings.BASE_DATA_DIR) / 'active-learning.lock').open('w') as lock:
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BlockingIOError as exc:
+                raise CommandError('An active learning worker is already running.') from exc
+            while True:
+                close_old_connections()
+                from ml.workflow import process_workflow_jobs
+                from ml.workflow_models import LearningRun
+                process_workflow_jobs()
+                process_backends()
+                if options['once']:
+                    return
+                time.sleep(1 if LearningRun.objects.filter(status__in=['queued','running']).exists() else max(5, options['interval']))

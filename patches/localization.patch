+      setModels(data.live||[]);setVersions(data.static||[]);
+    }catch{if(current===sequence.current){setError(true);setModels([]);setVersions([]);}}
+    finally{if(current===sequence.current)setLoading(false);}
+  },[api,apiName,project?.id]);
+  useEffect(()=>{refresh();return()=>{sequence.current++;};},[refresh]);
+  return <div>
+    <label htmlFor={`prelabel-${name}`}>{t("Select which predictions or which model you want to use:")}</label>
+    <FormField name={name} setValue={v=>setVersion(v||"")} {...props}>
+      {ref=><select id={`prelabel-${name}`} data-testid="prelabel-model-selector" ref={ref} name={name}
+        style={{display:"block",width:"100%",maxWidth:560,padding:10,border:"1px solid var(--color-neutral-border, #ccc)",borderRadius:6,color:"inherit",background:"var(--color-neutral-surface, white)"}}
+        value={version} onChange={e=>setVersion(e.target.value)} disabled={loading||(!models.length&&!versions.length)}>
+        <option value="" disabled>{t(loading?"Loading...":"Please select model or predictions")}</option>
+        {models.length>0&&<optgroup label={t("Models")}>{models.map(m=><option key={`model-${m.id}`} value={m.title}>{m.title} ({t(m.readable_state)})</option>)}</optgroup>}
+        {versions.length>0&&<optgroup label={t("Predictions")}>{versions.map(v=><option key={`version-${v.model_version}`} value={v.model_version}>{v.model_version} ({v.count} {t("Predictions")})</option>)}</optgroup>}
+      </select>}
+    </FormField>
+    {!loading&&!models.length&&!versions.length&&<p>{t("No model or predictions available")}</p>}
+    {error&&<p role="alert">{t("Unable to load prelabeling models.")}</p>}
+    <button type="button" onClick={refresh} disabled={loading} style={{marginTop:8}}>{t("Refresh models")}</button>
+    <p style={{fontSize:12,marginTop:8}}>{t("Save this selection, then reopen the task to retrieve predictions from the selected model. Existing manual annotations are preserved.")}</p>
+  </div>;
 };

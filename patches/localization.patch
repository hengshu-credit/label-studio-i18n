+
+def _cipher():
+    key = hashlib.sha256(
+        (settings.SECRET_KEY + ":translation-provider-config-v1").encode()
+    ).digest()
+    return Fernet(base64.urlsafe_b64encode(key))
+
+
+def read_config(organization_id):
+    con = _cache()
+    try:
+        row = con.execute(
+            "SELECT value FROM provider_config WHERE organization_id=?",
+            (organization_id,),
+        ).fetchone()
+        config = json.loads(_cipher().decrypt(row[0]).decode()) if row else {}
+        if not isinstance(config, dict):
+            raise ValueError()
+        return config
+    except (ValueError, InvalidToken) as exc:
+        raise TranslationFailure("Translation configuration is invalid.", 503) from exc
+    finally:
+        con.close()
+
+
+def save_config(organization_id, engine, body):
+    if engine not in ENGINES:
+        raise TranslationFailure("Unsupported translation engine.")
+    changes = {}
+    for field in ("key", "region", "app_id", "secret"):
+        value = body.get(field, "")
+        if not isinstance(value, str) or len(value) > 4096:
+            raise TranslationFailure("Invalid API configuration.")
+        if value.strip():
+            changes[field] = value.strip()
+    if "monthly_limit" in body:
+        try:
+            limit = int(body["monthly_limit"])
+        except (ValueError, TypeError):
+            raise TranslationFailure("Invalid monthly character limit.")
+        if not 0 <= limit <= ENGINES[engine]["free_characters"]:
+            raise TranslationFailure("Invalid monthly character limit.")
+        changes["monthly_limit"] = limit
+    con = _cache()
+    try:
+        con.execute("BEGIN IMMEDIATE")
+        row = con.execute(
+            "SELECT value FROM provider_config WHERE organization_id=?",
+            (organization_id,),
+        ).fetchone()
+        config = json.loads(_cipher().decrypt(row[0]).decode()) if row else {}
+        if not isinstance(config, dict):
+            raise ValueError()
+        if body.get("clear") is True:
+            config.pop(engine, None)
+        else:
+            config[engine] = {**config.get(engine, {}), **changes}
+        encrypted = _cipher().encrypt(json.dumps(config).encode())
+        con.execute(
+            "INSERT OR REPLACE INTO provider_config VALUES(?,?)",
+            (organization_id, encrypted),
+        )
+        con.commit()
+    except (ValueError, InvalidToken) as exc:
+        raise TranslationFailure("Translation configuration is invalid.", 503) from exc
+    finally:
+        con.close()
+
+
+def configured(engine, cfg):
+    return (
+        bool(cfg.get("app_id") and cfg.get("secret"))
+        if engine == "baidu"
+        else bool(cfg.get("key"))
+    )
+
+
+def limit_for(engine, cfg):
+    # Baidu defaults conservatively to the standard plan; advanced users can set 1,000,000.
+    default = 50000 if engine == "baidu" else ENGINES[engine]["free_characters"]
+    return min(
+        max(int(cfg.get("monthly_limit", default)), 0),
+        ENGINES[engine]["free_characters"],
+    )
+
+
+def capabilities(organization_id):
+    config = read_config(organization_id)
+    providers = []
+    for key, info in ENGINES.items():
+        cfg = config.get(key, {})
+        providers.append(
+            {
+                "id": key,
+                **info,
+                "configured": configured(key, cfg),
+                "monthly_limit": limit_for(key, cfg),
+                "languages": {
+                    k: v
+                    for k, v in LANGUAGES.items()
+                    if key != "baidu" or k in BAIDU_CODES
+                },
+            }
+        )
+    available = [p for p in providers if p["configured"]]
+    default = max(available or providers, key=lambda p: p["monthly_limit"])["id"]
+    return {
+        "providers": providers,
+        "default_engine": default,
+        "default_source": "auto",
+        "default_target": "zh",
+    }
+
+
+def _cache():
+    path = Path(settings.BASE_DATA_DIR) / "translation-cache.sqlite3"
+    con = sqlite3.connect(path, timeout=20)
+    con.execute("PRAGMA journal_mode=WAL")
+    con.executescript(
+        """CREATE TABLE IF NOT EXISTS results(key TEXT PRIMARY KEY,result TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS usage(account TEXT,month TEXT,characters INTEGER NOT NULL,PRIMARY KEY(account,month));
+      CREATE TABLE IF NOT EXISTS pending(key TEXT PRIMARY KEY,created REAL NOT NULL);
+      CREATE TABLE IF NOT EXISTS provider_config(organization_id INTEGER PRIMARY KEY,value BLOB NOT NULL);"""
+    )
+    return con
+
+
+def call_provider(engine, cfg, text, source, target):
+    # Fixed official endpoints only. Credentials never appear in URLs or error messages.
+    session = requests.Session()
+    try:
+        if engine == "azure":
+            code = lambda x: {"zh": "zh-Hans", "zh-TW": "zh-Hant", "tl": "fil"}.get(
+                x, x
+            )
+            params = {"api-version": "3.0", "to": code(target), "textType": "plain"}
+            if source != "auto":
+                params["from"] = code(source)
+            headers = {"Ocp-Apim-Subscription-Key": cfg["key"]}
+            if cfg.get("region"):
+                headers["Ocp-Apim-Subscription-Region"] = cfg["region"]
+            response = session.post(
+                "https://api.cognitive.microsofttranslator.com/translate",
+                params=params,
+                headers=headers,
+                json=[{"Text": text}],
+                timeout=(10, 45),
+                allow_redirects=False,
+            )
+        elif engine == "google":
+            body = {
+                "q": text,
+                "target": "zh-CN" if target == "zh" else target,
+                "format": "text",
+                "model": "nmt",
+            }
+            if source != "auto":
+                body["source"] = "zh-CN" if source == "zh" else source
+            response = session.post(
+                "https://translation.googleapis.com/language/translate/v2",
+                headers={"X-Goog-Api-Key": cfg["key"]},
+                json=body,
+                timeout=(10, 45),
+                allow_redirects=False,
+            )
+        else:
+            salt = secrets.token_hex(16)
+            signature = hashlib.md5(
+                (cfg["app_id"] + text + salt + cfg["secret"]).encode("utf-8")
+            ).hexdigest()
+            response = session.post(
+                "https://fanyi-api.baidu.com/api/trans/vip/translate",
+                data={
+                    "q": text,
+                    "from": "auto" if source == "auto" else BAIDU_CODES[source],
+                    "to": BAIDU_CODES[target],
+                    "appid": cfg["app_id"],
+                    "salt": salt,
+                    "sign": signature,
+                },
+                timeout=(10, 45),
+                allow_redirects=False,
+            )
+        if response.status_code == 429:
+            raise TranslationFailure(
+                "Translation provider rate limit reached. Try again later.", 429
+            )
+        if response.status_code in (401, 403):
+            raise TranslationFailure(
+                "Translation credentials or API permissions are invalid.", 503
+            )
+        if response.status_code != 200:
+            raise TranslationFailure("Translation provider is unavailable.", 502)
+        data = response.json()
+        if engine == "azure":
+            item = data[0]
+            translated = item["translations"][0]["text"]
+            detected = item.get("detectedLanguage", {}).get("language", source)
+            detected = {"zh-Hans": "zh", "zh-Hant": "zh-TW", "fil": "tl"}.get(
+                detected, detected
+            )
+        elif engine == "google":
+            item = data["data"]["translations"][0]
+            translated = html.unescape(item["translatedText"])
+            detected = item.get("detectedSourceLanguage", source)
+            detected = "zh" if detected == "zh-CN" else detected
+        else:
+            if "error_code" in data:
+                raise TranslationFailure(
+                    "Translation provider rejected the request. Check the account quota and language pair.",
+                    502,
+                )
+            translated = "\n".join(x["dst"] for x in data["trans_result"])
+            detected = {v: k for k, v in BAIDU_CODES.items()}.get(
+                data.get("from"), source
+            )
+        if not isinstance(translated, str) or not translated.strip():
+            raise ValueError("Empty translation")
+        return {
+            "translation": translated,
+            "detected_source": detected,
+            "target": target,
+            "engine": engine,
+        }
+    except TranslationFailure:
+        raise
+    except (
+        requests.RequestException,
+        ValueError,
+        KeyError,
+        IndexError,
+        TypeError,
+    ) as exc:
+        raise TranslationFailure(
+            "Translation request failed. Check the service connection and try again.",
+            502,
+        ) from None
+    finally:
+        session.close()
+
+
+def translate_text(text, engine, source, target, organization_id):
+    if engine not in ENGINES:
+        raise TranslationFailure("Unsupported translation engine.")
+    allowed = BAIDU_CODES if engine == "baidu" else LANGUAGES
+    if target not in allowed or (source != "auto" and source not in allowed):
+        raise TranslationFailure("Unsupported translation language.")
+    if not isinstance(text, str) or not text.strip():
+        raise TranslationFailure("This task has no inline text to translate.")
+    if len(text) > 5000:
+        raise TranslationFailure("Text exceeds the translation request limit.")
+    if source == target:
+        return {
+            "translation": text,
+            "detected_source": source,
+            "target": target,
+            "engine": engine,
+            "cached": True,
+        }
+    cfg = read_config(organization_id).get(engine, {})
+    if not configured(engine, cfg):
+        raise TranslationFailure(
+            "This translation engine is not configured. Ask the administrator to configure its API key.",
+            503,
+        )
+    if engine == "baidu" and len(text) > (
+        6000 if limit_for(engine, cfg) > 50000 else 1000
+    ):
+        raise TranslationFailure(
+            "Text exceeds this Baidu plan limit. Use the advanced plan or another engine."
+        )
+    account = (
+        engine
+        + ":"
+        + hashlib.sha256(str(cfg.get("key") or cfg.get("app_id")).encode()).hexdigest()
+    )
+    key = hashlib.sha256(
+        json.dumps(
+            [organization_id, account, source, target, text], ensure_ascii=False
+        ).encode()
+    ).hexdigest()
+    month = datetime.now(timezone.utc).strftime("%Y-%m")
+    characters = len(text.encode("utf-16-le")) // 2
+    con = _cache()
+    try:
+        con.execute("BEGIN IMMEDIATE")
+        hit = con.execute("SELECT result FROM results WHERE key=?", (key,)).fetchone()
+        if hit:
+            con.rollback()
+            return {**json.loads(hit[0]), "cached": True}
+        pending = con.execute(
+            "SELECT created FROM pending WHERE key=?", (key,)
+        ).fetchone()
+        if pending and time.time() - pending[0] < 120:
+            raise TranslationFailure(
+                "This text is already being translated. Try again shortly.", 429
+            )
+        used = con.execute(
+            "SELECT characters FROM usage WHERE account=? AND month=?", (account, month)
+        ).fetchone()
+        if (used[0] if used else 0) + characters > limit_for(engine, cfg):
+            raise TranslationFailure(
+                "The local monthly translation limit has been reached.", 429
+            )
+        con.execute("INSERT OR REPLACE INTO pending VALUES(?,?)", (key, time.time()))
+        con.execute(
+            "INSERT INTO usage VALUES(?,?,?) ON CONFLICT(account,month) DO UPDATE SET characters=characters+excluded.characters",
+            (account, month, characters),
+        )
+        con.commit()
+        # Reserve before the request, including failed attempts whose billing status is unknown.
+        try:
+            result = call_provider(engine, cfg, text, source, target)
+            with con:
+                con.execute(
+                    "INSERT OR REPLACE INTO results VALUES(?,?)",
+                    (key, json.dumps(result, ensure_ascii=False)),
+                )
+            return {**result, "cached": False}
+        finally:
+            with con:
+                con.execute("DELETE FROM pending WHERE key=?", (key,))
+    finally:
+        con.close()
+
+
+class TranslationOptionsAPI(APIView):
+    permission_classes = [IsAuthenticated]
+
+    def _organization(self, request):
+        org = request.user.active_organization
+        if org is None:
+            raise TranslationFailure("Permission denied.", 403)
+        return org
+
+    def _response(self, request, org):
+        return {
+            **capabilities(org.id),
+            "can_configure": bool(
+                request.user.is_superuser or org.created_by_id == request.user.id
+            ),
+        }
+
+    def get(self, request):
+        try:
+            return Response(self._response(request, self._organization(request)))
+        except TranslationFailure as exc:
+            return Response({"detail": str(exc)}, status=exc.status)
+
+    def post(self, request):
+        try:
+            if not isinstance(request.data, dict):
+                raise TranslationFailure("Invalid API configuration.")
+            org = self._organization(request)
+            if not (request.user.is_superuser or org.created_by_id == request.user.id):
+                raise TranslationFailure(
+                    "Only the organization owner can configure translation API keys.",
+                    403,
+                )
+            save_config(org.id, request.data.get("engine"), request.data)
+            return Response(self._response(request, org))
+        except TranslationFailure as exc:
+            return Response({"detail": str(exc)}, status=exc.status)
+
+
+class TaskTranslationAPI(APIView):
+    permission_classes = [IsAuthenticated]
+
+    def post(self, request, pk):
+        task = get_object_or_404(
+            Task.objects.select_related("project").filter(
+                project__organization=request.user.active_organization
+            ),
+            pk=pk,
+        )
+        if not task.has_permission(request.user):
+            return Response({"detail": "Permission denied."}, status=403)
+        try:
+            if not isinstance(request.data, dict):
+                raise TranslationFailure("Invalid API configuration.")
+            fields = [
+                x.get("value", "")[1:]
+                for x in fromstring(task.project.label_config).iter("Text")
+                if x.get("value", "").startswith("$")
+                and x.get("valueType", "text") == "text"
+            ]
+            field = request.data.get("field") or next(
+                (f for f in fields if isinstance(task.data.get(f), str)), None
+            )
+            if field not in fields:
+                raise TranslationFailure("This task has no inline text to translate.")
+            result = translate_text(
+                task.data.get(field),
+                request.data.get("engine", "azure"),
+                request.data.get("source", "auto"),
+                request.data.get("target", "zh"),
+                task.project.organization_id,
+            )
+            return Response({**result, "task_id": task.id, "field": field})
+        except TranslationFailure as exc:
+            return Response({"detail": str(exc)}, status=exc.status)

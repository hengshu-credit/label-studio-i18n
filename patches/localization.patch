+from django.db import models
+from django.conf import settings
+
+
+class AnnotationProvider(models.Model):
+    project = models.ForeignKey('projects.Project', on_delete=models.CASCADE)
+    name = models.CharField(max_length=120)
+    kind = models.CharField(max_length=30)
+    model = models.CharField(max_length=256, blank=True)
+    endpoint = models.URLField(blank=True)
+    encrypted_key = models.TextField(blank=True)
+    backend = models.ForeignKey('ml.MLBackend', null=True, blank=True, on_delete=models.RESTRICT)
+    options = models.JSONField(default=dict)
+    usage_month = models.CharField(max_length=7, blank=True)
+    requests_used = models.PositiveIntegerField(default=0)
+    updated_at = models.DateTimeField(auto_now=True)
+
+
+class LearningRun(models.Model):
+    project = models.ForeignKey('projects.Project', on_delete=models.CASCADE)
+    provider = models.ForeignKey(AnnotationProvider, null=True, on_delete=models.RESTRICT)
+    backend = models.ForeignKey('ml.MLBackend', null=True, on_delete=models.RESTRICT)
+    kind = models.CharField(max_length=20)
+    status = models.CharField(max_length=20, default='queued', db_index=True)
+    config = models.JSONField(default=dict)
+    report = models.JSONField(default=dict)
+    error = models.TextField(blank=True)
+    cancel_requested = models.BooleanField(default=False)
+    created_by = models.ForeignKey(settings.AUTH_USER_MODEL, on_delete=models.RESTRICT)
+    created_at = models.DateTimeField(auto_now_add=True)
+    updated_at = models.DateTimeField(auto_now=True)
+
+
+class LearningItem(models.Model):
+    run = models.ForeignKey(LearningRun, related_name='items', on_delete=models.CASCADE)
+    task = models.ForeignKey('tasks.Task', on_delete=models.CASCADE)
+    state = models.CharField(max_length=20, default='pending')
+    attempts = models.PositiveSmallIntegerField(default=0)
+    error = models.TextField(blank=True)
+    snapshot = models.JSONField(default=dict)
+    prediction = models.ForeignKey('tasks.Prediction', null=True, on_delete=models.SET_NULL)
+    class Meta:
+        constraints = [models.UniqueConstraint(fields=['run', 'task'], name='learning_run_task_unique')]
+        indexes = [models.Index(fields=['run', 'state'], name='learning_run_state_idx')]
+
+
+class ReviewCase(models.Model):
+    project = models.ForeignKey('projects.Project', on_delete=models.CASCADE)
+    task = models.OneToOneField('tasks.Task', on_delete=models.CASCADE)
+    status = models.CharField(max_length=20, default='open')
+    reasons = models.JSONField(default=list)
+    evidence = models.JSONField(default=dict)
+    note = models.TextField(blank=True)
+    reviewed_by = models.ForeignKey(settings.AUTH_USER_MODEL, null=True, on_delete=models.SET_NULL)
+    reviewed_at = models.DateTimeField(null=True)
+    updated_at = models.DateTimeField(auto_now=True)
+    class Meta:
+        indexes = [models.Index(fields=['project', 'status'], name='review_project_status_idx')]
+
+
+from django.db.models.signals import post_save
+from django.dispatch import receiver
+from django.db import transaction
+
+
+@receiver(post_save, sender='tasks.Annotation')
+def review_corrected_prediction(sender, instance, **kwargs):
+    if instance.was_cancelled:return
+    task_id=instance.task_id
+    def inspect():
+        from ml.workflow import analyze_task
+        from tasks.models import Task
+        import logging
+        try:
+            task=Task.objects.filter(pk=task_id).first()
+            if task is not None:analyze_task(task)
+        except Exception:
+            logging.getLogger(__name__).exception('Unable to analyze corrected annotation for task %s',task_id)
+    transaction.on_commit(inspect)

@@ -0,0 +1,92 @@
+import {useCallback,useContext,useEffect,useRef,useState} from "react";
+import {uiT as t} from "@humansignal/app-common/i18n/ui";
+import {ProjectContext} from "../../providers/ProjectProvider";
+import "./LearningWorkspace.css";
+
+const csrf=()=>decodeURIComponent(document.cookie.split("; ").find(x=>x.startsWith("csrftoken="))?.slice(10)||"");
+const initialProvider={name:"",kind:"local",model:"",endpoint:"",backend:"",api_key:"",options:{prompt:"",request_limit:1000,max_tokens:2048}};
+const labels={queued:"Queued",running:"Running",completed:"Completed",failed:"Failed",cancelled:"Cancelled",open:"Needs review",in_review:"In review",resolved:"Reviewed",excluded:"Excluded",predict:"Preannotation",train:"Training",analyze:"Analysis",low_confidence:"Low confidence",model_disagreement:"Model disagreement",human_correction:"Human correction",model_uncertain:"Model uncertainty",prediction_error:"Prediction error",manual:"Manual flag"};
+const title=x=>t(labels[x]||x);
+function summary(result){return (result||[]).map(r=>r.type==="choices"?`${r.from_name}: ${(r.value?.choices||[]).join(", ")}`:`${r.from_name}: ${r.value?.text||""} → ${(r.value?.labels||[]).join(", ")}`).join("\n")||"—";}
+
+export const LearningWorkspace=()=>{
+ const {project}=useContext(ProjectContext);
+ const [data,setData]=useState({providers:[],backends:[],runs:[],cases:[],review_counts:{},case_total:0});
+ const [tab,setTab]=useState("jobs"),[error,setError]=useState(""),[notice,setNotice]=useState(""),[busy,setBusy]=useState(false);
+ const [loadError,setLoadError]=useState("");
+ const [provider,setProvider]=useState(initialProvider),[filter,setFilter]=useState("open"),[page,setPage]=useState(1);
+ const [job,setJob]=useState({kind:"predict",provider:"",backend:"",scope:"unlabeled",limit:100,threshold:0.65,epochs:1,learning_rate:0.00002});
+ const [flag,setFlag]=useState(""),[notes,setNotes]=useState({});const generation=useRef(0);
+ const url=`/api/ml/projects/${project.id}/workflow`;
+ const refresh=useCallback(async()=>{
+  if(!project.id)return;
+  const current=++generation.current;
+  const response=await fetch(`${url}?review_status=${filter}&page=${page}`,{credentials:"same-origin"});
+  const value=await response.json();if(!response.ok)throw Error(value.detail||JSON.stringify(value));
+  if(current===generation.current){setData(value);setLoadError("");}
+ },[url,filter,page]);
+ const refreshRef=useRef(refresh);refreshRef.current=refresh;
+ useEffect(()=>{if(!project.id)return;refresh().catch(e=>setLoadError(e.message));const timer=setInterval(()=>{if(!document.hidden)refresh().catch(()=>{});},5000);return()=>{clearInterval(timer);generation.current++;};},[refresh]);
+ async function action(body){setBusy(true);setError("");setNotice("");try{
+  const response=await fetch(url,{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json","X-CSRFToken":csrf()},body:JSON.stringify(body)});
+  const result=await response.json();if(!response.ok)throw Error(result.detail||JSON.stringify(result));
+  await refreshRef.current();setNotice(t("Saved"));return result;
+ }catch(e){setError(e.message);return null;}finally{setBusy(false);}}
+ const field=(name,value)=>setProvider(old=>({...old,[name]:value}));
+ const opt=(name,value)=>setProvider(old=>({...old,options:{...old.options,[name]:value}}));
+ return <main className="learning-workspace" data-testid="learning-workspace">

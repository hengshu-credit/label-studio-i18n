diff --git a/label_studio/ml/active_learning.py b/label_studio/ml/active_learning.py
new file mode 100644
index 0000000..fba3365
--- /dev/null
+++ b/label_studio/ml/active_learning.py
@@ -0,0 +1,84 @@
+"""Durable, bounded active-learning rounds. Executed by one dedicated worker."""
+import hashlib
+import json
+from django.db.models import Count, Max, Exists, OuterRef, Q
+from django.utils import timezone
+from tasks.models import Annotation, Prediction
+from tasks.serializers import TaskSimpleSerializer
+from ml.models import MLBackend, MLBackendState
+
+
+def bounded(params, key, default, maximum):
+    value = int(params.get(key, default))
+    if not 1 <= value <= maximum:
+        raise ValueError(f'{key} must be between 1 and {maximum}')
+    return value
+
+
+def run_round(backend):
+    project = backend.project
+    params = backend.model_params()
+    pool_size = bounded(params, 'candidate_pool_size', 32, 512)
+    minimum = bounded(params, 'min_training_samples', 10, 10000)
+    interval = bounded(params, 'train_every', 10, 10000)
+    annotations = Annotation.objects.filter(project=project, was_cancelled=False)
+    summary = annotations.aggregate(count=Count('id'), latest=Max('updated_at'))
+    signature = {**summary, 'latest': str(summary['latest']), 'config': hashlib.sha256(
+        json.dumps([params, project.label_config], sort_keys=True).encode()).hexdigest()}
+    state = dict(backend.learning_state)
+    previous = state.get('trained', {})
+    changed = signature != previous
+    due = (state.get('requested') or previous.get('config') != signature['config'] or
+           summary['count'] >= previous.get('count', 0) + interval or
+           summary['count'] <= previous.get('count', 0))
+    if summary['count'] >= minimum and (changed or state.get('requested')) and due:
+        # Serialize only submitted human annotations, never predictions or drafts.
+        if summary['count'] > 10000:
+            raise ValueError('More than 10000 annotations: use an external training job; no annotations were truncated.')
+        tasks = []
+        for annotation in annotations.select_related('task').order_by('id'):
+            tasks.append({'id': annotation.task_id, 'data': annotation.task.data,
+                          'annotations': [{'id': annotation.pk, 'result': annotation.result,
+                                           'was_cancelled': False}]})
+        MLBackend.objects.filter(pk=backend.pk).update(state=MLBackendState.TRAINING)
+        response = backend.api._request('train', {
+            'project': backend.api._create_project_uid(project), 'label_config': project.label_config,
+            'annotations': tasks, 'params': params,
+        }, verbose=False, timeout=3600)
+        if response.is_error or not response.response.get('model_version'):
+            raise ValueError(response.error_message or 'Training must return a completed model_version')
+        state.update(trained=signature, requested=False, trained_at=timezone.now().isoformat())
+        # Persist before prediction: a prediction failure must not repeat successful training.
+        MLBackend.objects.filter(pk=backend.pk).update(learning_state=state)
+    backend.learning_state = state
+    backend.update_state()
+    if backend.not_ready:
+        raise ValueError(backend.error_message or 'ML backend is unavailable')
+    current = Prediction.objects.filter(task=OuterRef('pk'), model_version=backend.model_version)
+    available = project.tasks.filter(is_labeled=False).annotate(has_current=Exists(current)).filter(has_current=False)
+    # Consecutive rounds fill the pool, rather than scoring millions of tasks on submission.
+    scored_count = project.tasks.filter(is_labeled=False, predictions__model_version=backend.model_version,
+                                       predictions__score__isnull=False).distinct().count()
+    capacity = max(0, pool_size - scored_count)
+    batch = list(available.order_by('id')[:capacity])
+    if batch:
+        instances = backend.predict_tasks(batch)
+        if not isinstance(instances, list) or len(instances) != len(batch):
+            raise ValueError('Prediction refresh did not return one prediction per candidate')
+        if any(p.score is None or not 0 <= p.score <= 1 for p in instances):
+            Prediction.objects.filter(pk__in=[p.pk for p in instances]).delete()
+            raise ValueError('Active learning requires a finite confidence score from 0 to 1')
+    state.update(status='ready', error=None, candidate_pool_size=pool_size, last_checked=timezone.now().isoformat())
+    MLBackend.objects.filter(pk=backend.pk).update(learning_state=state, state=MLBackendState.CONNECTED, error_message=None)
+
+
+def process_backends():
+    for backend in MLBackend.objects.filter(Q(active_learning=True) | Q(learning_state__requested=True)).select_related('project'):
+        try:
+            run_round(backend)
+        except Exception as exc:
+            backend.refresh_from_db()
+            state = {**backend.learning_state, 'status': 'error', 'error': str(exc)[:1000],
+                     'last_checked': timezone.now().isoformat()}
+            MLBackend.objects.filter(pk=backend.pk).update(state=MLBackendState.ERROR,
+                learning_state=state, error_message=f'Active learning: {str(exc)[:1000]}')

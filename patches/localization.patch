+    "baidu": {"label": "Baidu Translate", "free_characters": 1000000},
+    "google": {"label": "Google Cloud Translation NMT", "free_characters": 500000},
+}
+
+
+class TranslationFailure(Exception):
+    def __init__(self, message, status=400):
+        super().__init__(message)

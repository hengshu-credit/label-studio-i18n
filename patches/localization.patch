diff --git a/web/libs/editor/src/components/SidePanels/TranslationPanel/TranslationPanel.tsx b/web/libs/editor/src/components/SidePanels/TranslationPanel/TranslationPanel.tsx
new file mode 100644
index 0000000..b339d2f
--- /dev/null
+++ b/web/libs/editor/src/components/SidePanels/TranslationPanel/TranslationPanel.tsx
@@ -0,0 +1,134 @@
+import { inject, observer } from "mobx-react";
+import { useEffect, useRef, useState } from "react";
+import { uiT as t } from "@humansignal/app-common/i18n/ui";
+import { cn } from "../../../utils/bem";
+import "./TranslationPanel.prefix.css";
+
+type Provider = {id:string;label:string;configured:boolean;monthly_limit:number;languages:Record<string,string>};
+type Preferences = {engine:string;source:string;target:string};
+const storageKey = "label-studio.translation-preferences";
+function readPreferences(): Preferences {
+  try { return {engine:"",source:"auto",target:"zh",...JSON.parse(localStorage.getItem(storageKey)||"{}")}; }
+  catch { return {engine:"",source:"auto",target:"zh"}; }
+}
+function csrf() {
+  return decodeURIComponent(document.cookie.split("; ").find(v=>v.startsWith("csrftoken="))?.split("=").slice(1).join("=")||"");
+}
+
+export const TranslationPanel = inject("store")(observer(({store,isActive=true}:any) => {
+  const taskId = store?.task?.id;
+  const [providers,setProviders] = useState<Provider[]>([]);
+  const [prefs,setPrefs] = useState<Preferences>(readPreferences);
+  const [result,setResult] = useState<any>(null);
+  const [error,setError] = useState("");
+  const [busy,setBusy] = useState(false);
+  const [canConfigure,setCanConfigure] = useState(false);
+  const [credentials,setCredentials] = useState({key:"",region:"",app_id:"",secret:""});
+  const [monthlyLimit,setMonthlyLimit] = useState(0);
+  const [saving,setSaving] = useState(false);
+  const [saved,setSaved] = useState(false);
+  const request = useRef<AbortController|null>(null);
+  const generation = useRef(0);
+  const provider = providers.find(p=>p.id===prefs.engine);
+
+  useEffect(()=>{
+    if(!isActive)return;
+    const controller=new AbortController();
+    fetch("/api/tasks/translation-options/",{credentials:"same-origin",signal:controller.signal})
+      .then(async response=>{const data=await response.json();if(!response.ok)throw Error(data.detail||"Unable to load translation engines.");return data;})
+      .then(data=>{
+        setProviders(data.providers);
+        setCanConfigure(data.can_configure);
+        setPrefs(old=>({...old,engine:data.providers.some((p:Provider)=>p.id===old.engine)?old.engine:data.default_engine}));
+      }).catch(e=>{if(e.name!=="AbortError")setError(e.message);});
+    return ()=>controller.abort();
+  },[isActive]);
+
+  useEffect(()=>{
+    generation.current++;request.current?.abort();setBusy(false);setResult(null);setError("");
+    try {localStorage.setItem(storageKey,JSON.stringify(prefs));} catch {}
+    return ()=>request.current?.abort();
+  },[taskId,prefs.engine,prefs.source,prefs.target,isActive]);
+
+  useEffect(()=>{
+    setCredentials({key:"",region:"",app_id:"",secret:""});setSaved(false);
+    setMonthlyLimit(provider?.monthly_limit||0);
+  },[prefs.engine,provider?.monthly_limit]);
+
+  async function saveCredentials(clear=false) {
+    setSaving(true);setSaved(false);setError("");
+    try {
+      const response=await fetch("/api/tasks/translation-options/",{method:"POST",credentials:"same-origin",
+        headers:{"Content-Type":"application/json","X-CSRFToken":csrf()},
+        body:JSON.stringify({engine:prefs.engine,...credentials,monthly_limit:monthlyLimit,clear})});
+      const data=await response.json();if(!response.ok)throw Error(data.detail||"Unable to save API configuration.");
+      setProviders(data.providers);setCredentials({key:"",region:"",app_id:"",secret:""});setSaved(true);
+    } catch(e:any){setError(e.message);} finally{setSaving(false);}
+  }
+
+  function change(key:keyof Preferences,value:string) {
+    setPrefs(old=>{
+      const next={...old,[key]:value};const engine=providers.find(p=>p.id===next.engine);
+      if(engine && next.source!=="auto" && !engine.languages[next.source])next.source="auto";
+      if(engine && !engine.languages[next.target])next.target="zh";
+      return next;
+    });
+  }
+  async function translate() {
+    request.current?.abort();const controller=new AbortController();request.current=controller;
+    const current=++generation.current;setBusy(true);setError("");setResult(null);
+    try {
+      const response=await fetch(`/api/tasks/${taskId}/translate/`,{method:"POST",credentials:"same-origin",signal:controller.signal,
+        headers:{"Content-Type":"application/json","X-CSRFToken":csrf()},body:JSON.stringify(prefs)});
+      const data=await response.json();if(!response.ok)throw Error(data.detail||"Translation request failed.");
+      if(current===generation.current)setResult(data);
+    } catch(e:any) {if(e.name!=="AbortError"&&current===generation.current)setError(e.message);}
+    finally {if(current===generation.current)setBusy(false);}
+  }
+  if(!isActive)return null;
+  return <section className={cn("translation-panel").toClassName()} data-testid="translation-panel">
+    <label>{t("Translation engine")}
+      <select aria-label={t("Translation engine")} value={prefs.engine} onChange={e=>change("engine",e.target.value)}>
+        {!providers.length&&<option value="">{t("Loading...")}</option>}
+        {providers.map(p=><option key={p.id} value={p.id}>{p.label}{p.configured?"":` (${t("Not configured")})`}</option>)}
+      </select>
+    </label>
+    <div className={cn("translation-panel").elem("languages").toClassName()}>
+      <label>{t("Source language")}<select aria-label={t("Source language")} value={prefs.source} onChange={e=>change("source",e.target.value)}>
+        <option value="auto">{t("Auto-detect")}</option>
+        {Object.entries(provider?.languages||{}).map(([code,label])=><option key={code} value={code}>{t(label)}</option>)}
+      </select></label>
+      <label>{t("Target language")}<select aria-label={t("Target language")} value={prefs.target} onChange={e=>change("target",e.target.value)}>
+        {Object.entries(provider?.languages||{zh:"Chinese (Simplified)"}).map(([code,label])=><option key={code} value={code}>{t(label)}</option>)}
+      </select></label>
+    </div>
+    {provider&&<p className={cn("translation-panel").elem("hint").toClassName()}>{t("Local monthly character limit")}: {provider.monthly_limit.toLocaleString()}</p>}
+    {provider&&!provider.configured&&<p role="status">{t(canConfigure?"Configure an API key below to enable this engine.":"Ask the organization owner to configure this translation engine.")}</p>}
+    {provider&&canConfigure&&<details className={cn("translation-panel").elem("config").toClassName()}>
+      <summary>{t("API settings")}</summary>
+      <p className={cn("translation-panel").elem("hint").toClassName()}>{t("Keys are encrypted on the server and are never returned to the browser. Leave a field blank to keep its saved value.")}</p>
+      {prefs.engine==="baidu"?<>
+        <label>App ID<input aria-label="App ID" autoComplete="off" value={credentials.app_id} onChange={e=>setCredentials(v=>({...v,app_id:e.target.value}))}/></label>
+        <label>{t("Secret Key")}<input aria-label={t("Secret Key")} type="password" autoComplete="new-password" value={credentials.secret} onChange={e=>setCredentials(v=>({...v,secret:e.target.value}))}/></label>
+      </>:<label>API Key<input aria-label="API Key" type="password" autoComplete="new-password" value={credentials.key} onChange={e=>setCredentials(v=>({...v,key:e.target.value}))}/></label>}
+      {prefs.engine==="azure"&&<label>{t("Azure region")}<input aria-label={t("Azure region")} autoComplete="off" value={credentials.region} onChange={e=>setCredentials(v=>({...v,region:e.target.value}))}/></label>}
+      <label>{t("Local monthly character limit")}<input aria-label={t("Local monthly character limit")} type="number" min={0} max={providers.find(p=>p.id===prefs.engine)?.id==='azure'?2000000:prefs.engine==='baidu'?1000000:500000} value={monthlyLimit} onChange={e=>setMonthlyLimit(Number(e.target.value))}/></label>
+      <p className={cn("translation-panel").elem("hint").toClassName()}>{t("Calls stop at this local limit. Provider billing and usage outside this application are separate.")}</p>
+      <div className={cn("translation-panel").elem("actions").toClassName()}>
+        <button type="button" disabled={saving} onClick={()=>saveCredentials()}>{t(saving?"Saving...":"Save API settings")}</button>
+        {provider.configured&&<button type="button" disabled={saving} onClick={()=>saveCredentials(true)}>{t("Remove saved key")}</button>}
+      </div>
+      {saved&&<p role="status">{t("API settings saved. Existing keys are not displayed.")}</p>}
+    </details>}
+    <button type="button" className={cn("translation-panel").elem("button").toClassName()} disabled={busy||!taskId||!provider?.configured} onClick={translate}>
+      {t(busy?"Translating...":"Translate current text")}
+    </button>
+    {error&&<p role="alert" className={cn("translation-panel").elem("error").toClassName()}>{t(error)}</p>}
+    {result&&<>
+      <p className={cn("translation-panel").elem("hint").toClassName()}>{t("Detected language")}: {t(provider?.languages[result.detected_source]||result.detected_source)}{result.cached?` · ${t("Cached translation")}`:""}</p>
+      <textarea aria-label={t("Translation result")} readOnly rows={10} value={result.translation}/>
+      <button type="button" onClick={()=>navigator.clipboard.writeText(result.translation)}>{t("Copy translation")}</button>
+    </>}
+    <p className={cn("translation-panel").elem("hint").toClassName()}>{t("Translation is for reference only. Annotate the original text; translations never replace task data or annotations.")}</p>
+  </section>;
+}));
